NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Leave true for Neon. Use false only for a local PostgreSQL instance without TLS.
DATABASE_SSL=true
DATABASE_POOL_MAX=10
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_API_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
# Keep false until payment, delivery and operational policies are approved.
CHECKOUT_ENABLED=false
# MTN Mobile Money Collection sandbox. Keep checkout disabled until all credentials are supplied.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=replace-with-mtn-sandbox-subscription-key
MTN_MOMO_API_USER_ID=replace-with-mtn-sandbox-api-user-uuid
MTN_MOMO_API_SECRET=replace-with-mtn-sandbox-api-secret
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_SECRET=replace-with-at-least-32-random-characters
# Comma-separated browser origins. No wildcard is allowed.
CORS_ORIGINS=http://localhost:3000
