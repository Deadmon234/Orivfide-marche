NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Leave true for Neon. Use false only for a local PostgreSQL instance without TLS.
DATABASE_SSL=true
DATABASE_POOL_MAX=10
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_API_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
# Comma-separated browser origins. No wildcard is allowed.
CORS_ORIGINS=http://localhost:3000
# Set all WhatsApp variables together to enable customer phone verification.
# Use a Meta-approved Authentication template with a body code parameter and Copy code button.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=fr
# WHATSAPP_GRAPH_API_VERSION=vXX.0
