NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Leave true for Neon. Use false only for a local PostgreSQL instance without TLS.
DATABASE_SSL=true
DATABASE_POOL_MAX=10
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
# Comma-separated browser origins. No wildcard is allowed.
CORS_ORIGINS=http://localhost:3000
CONTRACT_DRAFT_VERSION=orivfide-seller-draft-v1
